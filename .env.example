# =============================================================================
# Firebase Web Configuration Template for Owner / Admin Portal (Vite)
# Govindasamy & Co / Surya Tex - Admin Management Portal
# =============================================================================
# Copy this file to .env in this directory (surya-tex-owner/.env)
# Fill in your new Firebase project credentials from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# =============================================================================

# 1. Firebase Web App Configuration Keys
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Store Administrator Email Identity
# This email is used for MFA, TOTP authenticator registration, and login verification
VITE_ADMIN_EMAIL=your_admin_email@example.com

# 3. Optional: Backend Cloud Functions / API Server URL
VITE_SERVER_URL=http://localhost:10000

# 4. Optional: Firebase Local Emulator Suite (set true only during local offline testing)
VITE_USE_FIREBASE_EMULATOR=false
